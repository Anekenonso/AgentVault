{
  "name": "agentvault",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:contracts": "stellar contract build",
    "test:contracts": "cargo test --lib",
    "lint:contracts": "cargo clippy -- -D warnings",
    "fmt:contracts": "cargo fmt --check",
    "bindings:vault": "tsx scripts/generate-bindings.ts",
    "bindings:check": "tsx scripts/generate-bindings.ts --check",
    "deploy:testnet": "tsx scripts/deploy.ts",
    "smoke:testnet": "tsx scripts/smoke.ts",
    "verify:evidence": "tsx scripts/verify-evidence.ts",
    "test:apps": "vitest run",
    "build:web": "npm --workspace=@agentvault/web run build",
    "dev:web": "npm --workspace=@agentvault/web run dev",
    "redteam:run": "tsx scripts/redteam/run-redteam.ts",
    "e2e:happy": "tsx scripts/e2e-happy-path.ts"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "express": "^5.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "openai": "^7.32.0",
    "zod": "^4.6.5"
  }
}
